<!DOCTYPE html>
<html lang="es">

<style>
    :root {
        --black-bg: #000;
        --white-cl: #fff;
    }
    main{
        background: whitesmoke;
    }
</style>
<head>
    <meta charset="UTF-8">
    <meta name="description" content="formulario equipo de futbol estudiantes">
    <title>Formulario de inscripcion| Equipo de futbol</title>
    <script></script>
</head>
<body>
    <main>
        
    <div class="titulo">
    <img src="logofutbol.png" alt="Logo de fútbol">
    <h1>
        Inscripcion a equipo S2-2026
    </h1> 
    </div>

    <!--CAMPO CARNET ESTUDIANTE-->  

    <div class="studentId">
    <form autocomplete="off">
    <label for="studentId">Carné estudiante </label>
    <input type="text" id = "studentId" required/>
    </div>

    <div class = "studentName">
    <label for="studentName">Nombre estudiante </label>
    <input type="text" name = "studentName" required/>
    </div>

    <div class = "studentAge"> 
    <label for="studentAge">Año de nacimiento </label>
    <input type="date" age = "studentAge" required max="2010-07-23"/>
    </div>

    <div class = "teamName">
    <label for="teamName">Nombre del equipo </label>
    <select>
    <option value="">Seleccione un equipo</option>
    <option value="FC barcelona">FC Barcelona</option>
    <option value="real-madrid">Real Madrid</option>
    <option value="manchester">Manchester City</option>
    <option value="bayern">Bayern Munich</option>
    </select>
    </div>

    <input type="submit" value="Enviar" />
    </form>

    </main>
    
</body>
</html>